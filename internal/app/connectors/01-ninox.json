      "body": [
        {
          "fields": {
            "Name": "{{name}}",
            "E-Mail": "{{email}}"
          }
        }
      ]
    },
    {
      "name": "Datensatz ändern",
      "slug": "ninox-aendern",
      "method": "POST",
      "path": "/tables/{TABLE_ID}/records",
      "query": [],
      "fields": [],
      "body_format": "",
      "note": "Ninox ändert den Datensatz mit der übergebenen ID. Feldnamen anpassen.",
      "body": [
        {
          "id": "{{id}}",
          "fields": {
            "Status": "{{status}}"
          }
        }
      ]
    }
