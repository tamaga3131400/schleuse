      "query": [],
      "fields": [],
      "body_format": "",
      "note": ""
    },
    {
      "name": "Datensätze lesen",
      "slug": "ninox-datensaetze",
      "method": "GET",
      "path": "/tables/{TABLE_ID}/records",
      "query": [
        "perPage",
        "page"
      ],
      "fields": [],
      "body_format": "",
      "note": ""
    },
    {
      "name": "Datensatz lesen",
      "slug": "ninox-datensatz",
      "method": "GET",
      "path": "/tables/{TABLE_ID}/records/{id}",
      "query": [],
      "fields": [],
      "body_format": "",
      "note": ""
    },
    {
      "name": "Datensatz anlegen",
      "slug": "ninox-anlegen",
      "method": "POST",
      "path": "/tables/{TABLE_ID}/records",
      "query": [],
      "fields": [],
      "body_format": "",
